{
  "name": "micenae",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "import:usda": "node scripts/import-usda.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-micenae-rules \"vitest run -c vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project micenae-ef391",
    "dev:emulators": "VITE_USE_EMULATORS=true vite",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "upload:foods": "node scripts/upload-foods.mjs",
    "build:preview": "VITE_PREVIEW=true vite build --base ./ --outDir dist-preview"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "fflate": "^0.8.3",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
