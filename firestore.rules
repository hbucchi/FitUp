rules_version = '2';

// Each user can read and write only their own subtree: users/{uid}/**
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{docId} {
        allow read, write: if isOwner(uid)
          && collection in ['foodEntries', 'trainingEntries', 'customFoods', 'customExercises', 'bodyLog', 'plannedSessions', 'checkIns'];
      }
    }

    // Shared food catalog: readable by any signed-in user, written only by the
    // admin upload script (scripts/upload-foods.mjs), which bypasses these rules.
    match /foods/{foodId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /catalog/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
